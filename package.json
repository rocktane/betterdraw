{
  "name": "betterdraw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "size": "size-limit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "immer": "^11.2.9",
    "jspdf": "^4.2.1",
    "nanoid": "^6.0.2",
    "paper": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.9.0",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "size-limit": "^14.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
